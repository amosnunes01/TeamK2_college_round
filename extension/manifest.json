{
  "manifest_version": 3,
  "name": "Handsfree Extension",
  "version": "1.2",
  "description": "External page targeting, scrolling and voice for Handsfree",
  "permissions": ["tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
